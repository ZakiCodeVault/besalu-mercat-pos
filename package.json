{
  "name": "besalu-mercat-pos",
  "productName": "Besalu Mercat POS",
  "version": "2.1.0",
  "description": "Sistema de facturación y punto de venta de Besalú Mercat (local, Windows, SQLite)",
  "author": "Besalu Mercat",
  "license": "UNLICENSED",
  "private": true,
  "main": "principal/main.js",
  "scripts": {
    "iniciar": "electron .",
    "start": "electron .",
    "prueba": "npm run prueba:datos && npm run prueba:hacienda && npm run prueba:correo && npm run prueba:app",
    "prueba:datos": "electron pruebas/datos.prueba.js",
    "prueba:hacienda": "electron pruebas/hacienda.prueba.js",
    "prueba:correo": "electron pruebas/correo.prueba.js",
    "prueba:app": "electron pruebas/prueba-completa.js",
    "reconstruir": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "node-forge": "^1.4.0",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "xml-crypto": "^6.4.0"
  },
  "build": {
    "appId": "com.besalu.mercatpos",
    "productName": "Besalu Mercat POS",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "principal/**/*",
      "interfaz/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ZakiCodeVault",
        "repo": "besalu-mercat-pos"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "recursos/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Besalu Mercat POS",
      "installerSidebar": "recursos/panel-instalador.bmp",
      "uninstallerSidebar": "recursos/panel-instalador.bmp",
      "license": "recursos/licencia.txt",
      "artifactName": "BesaluMercatPOS-Setup-${version}.exe"
    }
  }
}
