{
  "name": "besalu-mercat-pos",
  "productName": "Besalu Mercat POS",
  "version": "1.0.2",
  "description": "Punto de venta Besalu Mercat (local, Windows)",
  "author": "Besalu Mercat",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "node-sqlite3-wasm": "^0.8.60"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.besalu.mercatpos",
    "productName": "Besalu Mercat POS",
    "directories": { "output": "dist" },
    "files": [ "main.js", "preload.js", "renderer/**/*", "package.json" ],
    "asarUnpack": [ "**/node_modules/node-sqlite3-wasm/**" ],
    "publish": [
      { "provider": "github", "owner": "ZakiCodeVault", "repo": "besalu-mercat-pos" }
    ],
    "win": {
      "target": [ { "target": "nsis", "arch": [ "x64" ] } ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Besalu Mercat POS",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "build/license.txt",
      "artifactName": "BesaluMercatPOS-Setup-${version}.exe"
    }
  }
}
