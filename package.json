{
  "name": "besalu-mercat-pos",
  "productName": "Besalu Mercat POS",
  "version": "2.2.0",
  "description": "Sistema de facturación y punto de venta de Besalú Mercat (local, Windows, SQLite)",
  "author": "Besalu Mercat",
  "license": "UNLICENSED",
  "private": true,
  "main": "principal/main.js",
  "scripts": {
    "iniciar": "electron .",
    "start": "electron .",
    "prueba": "npm run prueba:datos && npm run prueba:hacienda && npm run prueba:correo && npm run prueba:app",
    "prueba:datos": "electron pruebas/datos.prueba.js",
    "prueba:hacienda": "electron pruebas/hacienda.prueba.js",
    "prueba:correo": "electron pruebas/correo.prueba.js",
    "prueba:app": "electron pruebas/app.prueba.js",
    "reconstruir": "electron-builder install-app-deps",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.10",
    "node-forge": "1.4.2",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "xml-crypto": "^6.4.0"
  },
  "build": {
    "appId": "com.besalu.mercatpos",
    "productName": "Besalu Mercat POS",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "principal/**/*",
      "interfaz/**/*",
      "package.json",
      "!**/node_modules/better-sqlite3/{deps,src}/**",
      "!**/node_modules/better-sqlite3/binding.gyp",
      "!**/node_modules/better-sqlite3/build/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true,
      "resetAdHocDarwinSignature": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZakiCodeVault",
        "repo": "besalu-mercat-pos"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "recursos/icono.png",
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/{darwin-*,linux-*,linuxmusl-*,win32-arm64}.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Besalu Mercat POS",
      "installerSidebar": "recursos/panel-instalador.bmp",
      "uninstallerSidebar": "recursos/panel-instalador.bmp",
      "license": "recursos/licencia.txt",
      "artifactName": "BesaluMercatPOS-Setup-${version}.exe"
    }
  }
}
